# Copy to .env and fill in. Supabase dashboard > Project Settings > API (or the "Connect" dialog).

# Used by the browser (public values; anything starting with VITE_ ends up in the website's code):
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used only by the Express server. NEVER put this in a VITE_ variable or commit it:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_URL=            # optional: defaults to VITE_SUPABASE_URL
# PORT=4000
